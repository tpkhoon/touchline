{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "checkJs": false, // (only a file with // @ts-check on its first line is checked: npm run typecheck)
    "noImplicitAny": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": ["js/**/*.js", "tools/**/*.mjs", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "android", "ios"]
}
